# Copy to the OpenClaw gateway environment on the Alibaba server.
# Never commit real secrets.

HOTEL_OTA_DB=/var/lib/hotel-ota-ai/hotel_ops.sqlite
HOTEL_OTA_LOG_DIR=/var/log/hotel-ota-ai
HOTEL_OTA_ENV=production
HOTEL_OTA_FEISHU_DEBUG=0
HOTEL_OTA_FEISHU_FINAL_GATE_REQUIRED=1
HOTEL_OTA_FEISHU_ALLOW_FILE_EXPORT=0
HOTEL_OTA_FEISHU_ALLOW_CONFIG_EXPORT=0
HOTEL_OTA_FEISHU_ALLOW_RAW_DATA_EXPORT=0
HOTEL_OTA_AUTH_CONFIG=/etc/hotel-ota-ai/feishu-role-map.json
HOTEL_OTA_DB_SOURCE_ENABLE=0
HOTEL_OTA_DB_KIND=sqlite
HOTEL_OTA_DB_PROFILE=report_mysql_prod
HOTEL_OTA_DB_DSN=
HOTEL_OTA_DB_READONLY=1
HOTEL_OTA_DB_MAPPING_CONFIG=/etc/hotel-ota-ai/database-source.json

BEYONDH_BASE_URL=https://openapi.beyondh.com
BEYONDH_DOMAIN=replace-with-pms-domain
BEYONDH_CHANNEL_KEY=replace-with-channel-key
BEYONDH_APP_KEY=replace-with-app-key
BEYONDH_SIGN_TYPE=MD5
BEYONDH_ORG_ID=replace-with-org-id

# Live execution is disabled unless this is exactly 1.
BEYONDH_ENABLE_LIVE=0

# Optional reference only. Meituan API permissions and field access are not a
# P0/P1 dependency. Keep empty until the developer account scope is confirmed.
MEITUAN_BASE_URL=https://api-open-cater.meituan.com
MEITUAN_DEVELOPER_ID=
MEITUAN_SIGN_KEY=
MEITUAN_APP_AUTH_TOKEN=
MEITUAN_ENABLE_LIVE=0

# Optional reference only. Dingdanll/order-coming API permissions, RSA keys,
# AES keys, store token, and callback URL must be confirmed before live use.
DINDANLL_BASE_URL=https://open.dingdanll.com
DINDANLL_APP_CODE=
DINDANLL_AUTH_ACCESS_TOKEN=
DINDANLL_VERSION=3.0
DINDANLL_ENABLE_LIVE=0
