{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S14当前诊断输入",
  "description": "先选择数据库或Excel。报告统一使用platform=multi，不接收渠道选择。",
  "type": "object",
  "additionalProperties": false,
  "required": ["hotel_id", "data_source_mode"],
  "properties": {
    "data_source_mode": {
      "type": "string",
      "enum": ["database", "excel_upload"],
      "description": "数据库模式或上传Excel模式。"
    },
    "input_excel_path": {
      "type": ["string", "null"],
      "description": "Excel下载后的本地路径，仅excel_upload模式必填。"
    },
    "hotel_id": {
      "type": "string",
      "minLength": 1,
      "default": "puyue"
    },
    "hotel_name": {
      "type": ["string", "null"],
      "default": "璞悦·奢电竞酒店(贵阳花溪公园店)"
    },
    "platform": {
      "type": "string",
      "const": "multi",
      "default": "multi",
      "description": "当前固定为整体诊断，不区分渠道。"
    },
    "channel_source": {
      "type": ["string", "null"],
      "enum": ["整体诊断", null],
      "default": "整体诊断"
    },
    "channel_mode": {
      "type": ["string", "null"],
      "enum": ["multi", null],
      "default": "multi"
    },
    "period_start": {
      "type": ["string", "null"],
      "format": "date",
      "description": "为空时取最近30天。"
    },
    "period_end": {
      "type": ["string", "null"],
      "format": "date",
      "description": "为空时取当天。"
    },
    "output_dir": {
      "type": "string",
      "default": "/var/lib/ota-marketing-diagnosis/reports"
    },
    "public_base_url": {
      "type": ["string", "null"],
      "default": "http://47.108.200.194:8081/s14-reports"
    },
    "dry_run": {
      "type": "boolean",
      "default": true
    }
  },
  "not": {
    "anyOf": [
      {"required": ["metrics"]},
      {"required": ["business_fields"]},
      {"required": ["upstream_skill_output"]},
      {"required": ["json_payload"]},
      {"required": ["manual_diagnosis_input"]}
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data_source_mode": {"const": "excel_upload"}
        }
      },
      "then": {
        "required": ["input_excel_path"]
      }
    }
  ]
}
