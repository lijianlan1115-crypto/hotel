{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S14当前23项诊断输出",
  "description": "数据库和Excel均由ota-marketing-diagnosis生成。旧M01-M08模块不再是输出契约。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "status",
    "skill_id",
    "run_id",
    "hotel_id",
    "hotel_name",
    "platform",
    "channel_source",
    "period_start",
    "period_end",
    "final_score",
    "risk_level",
    "data_source",
    "formula_source",
    "execution_steps",
    "report_file_path",
    "report_url",
    "feishu_message",
    "feishu_card"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed"]
    },
    "skill_id": {
      "type": "string",
      "const": "s14-operation-diagnosis"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "hotel_id": {
      "type": "string",
      "minLength": 1
    },
    "hotel_name": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "const": "multi"
    },
    "channel_source": {
      "type": "string",
      "const": "整体诊断"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "raw_score": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "final_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "data_source": {
      "type": "string",
      "enum": ["database", "excel_upload"]
    },
    "visual_diagnosis": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "minItems": 23,
          "items": {
            "type": "object"
          }
        },
        "raw_score": {
          "type": ["number", "null"]
        },
        "normalized_score": {
          "type": ["number", "null"]
        }
      },
      "required": ["items"]
    },
    "module_scores": {
      "type": "array",
      "maxItems": 0,
      "description": "旧M01-M08兼容字段，当前固定为空数组。"
    },
    "caps": {
      "type": "array"
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "formula_source": {
      "type": "string",
      "pattern": "visual_diagnosis_v14\\.py$"
    },
    "execution_steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["step", "status", "detail"],
        "properties": {
          "step": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["ok", "partial", "failed"]
          },
          "detail": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "field_contract_file": {
      "type": "string",
      "const": "S14酒店诊断_中文表头上传模板.xlsx"
    },
    "field_mapping_source": {
      "type": "string",
      "const": "ota-marketing-diagnosis/excel_loader_v2.py"
    },
    "approval_required": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "report_file_path": {
      "type": "string",
      "minLength": 1
    },
    "report_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "feishu_message": {
      "type": "string",
      "minLength": 1
    },
    "feishu_card": {
      "type": "object",
      "required": ["msg_type", "card"],
      "properties": {
        "msg_type": {
          "type": "string",
          "const": "interactive"
        },
        "card": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}
